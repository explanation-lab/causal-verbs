# Local operating-system and editor files
.DS_Store
Thumbs.db
*~

# Local R state and caches (keep scripts and reproducible environments)
.Rhistory
.RData
.Ruserdata
.Rproj.user/

# Optional Python environments and caches
__pycache__/
*.py[cod]
.venv/
venv/

# Local credentials and restricted working areas
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
service-account*.json
/data/raw/
/data/private/
/data/identifiable/

# These patterns are a convenience, not a privacy audit. Review every commit.

# Restricted data may never be staged here, including historical exports.
**/*identifiable*.json
**/pilot1_exp1.json
**/pilot1_participants.csv
**/raw_recordings/
**/participant_recordings/
**/*-videos.csv
**/videoStream_*
**/private/
**/credentials/
**/*crosswalk*
**/*private-key*
**/import-key.bin
node_modules/
~$*
